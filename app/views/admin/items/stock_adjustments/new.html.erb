<% content_for :title, "ปรับสต็อก" %>

<div class="mx-auto md:w-2/3 w-full">
  <h1 class="text-2xl font-bold mb-2">ปรับสต็อก</h1>
  <p class="text-gray-600 mb-6">
    <span class="font-mono"><%= @item.sku %></span> <%= @item.name %>
    คงเหลือ <strong id="current_quantity"><%= number_with_delimiter(@item.quantity) %></strong> <%= @item.unit %>
  </p>

  <%= form_with model: @stock_adjustment, scope: :stock_adjustment, url: admin_item_stock_adjustment_path(@item), method: :post, class: "space-y-5 bg-white rounded-lg shadow-sm p-6" do |form| %>
    <%= render "shared/form_errors", record: @stock_adjustment %>

    <div>
      <%= form.label :change, class: "block font-medium" %>
      <%= form.number_field :change, step: 1, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-1 w-full" %>
      <p class="text-sm text-gray-500 mt-1">ใส่จำนวนบวกเพื่อรับเข้า หรือจำนวนลบเพื่อตัดออก</p>
    </div>

    <div class="flex items-center gap-3">
      <%= form.submit "บันทึก", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= link_to "ยกเลิก", admin_items_path, class: "text-gray-600 underline" %>
    </div>
  <% end %>
</div>
