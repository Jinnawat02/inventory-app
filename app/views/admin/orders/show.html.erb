<% content_for :title, "ใบเบิก ##{@order.id}" %>

<div class="mx-auto md:w-2/3 w-full">
  <%= link_to "← ใบเบิกทั้งหมด", admin_orders_path, class: "text-sm text-gray-600 hover:underline" %>

  <div class="mt-4 bg-white rounded-lg shadow-sm p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold">ใบเบิก #<%= @order.id %></h1>
        <p class="text-sm text-gray-600" id="order_requester">ผู้ขอเบิก: <%= @order.user.name %> (<%= @order.user.email_address %>)</p>
      </div>
      <span id="order_status"><%= @order.status_name %></span>
    </div>

    <p class="mt-4 text-gray-700 whitespace-pre-line" id="order_purpose"><%= @order.purpose %></p>

    <%= render "orders/lines", order: @order %>
  </div>
</div>
