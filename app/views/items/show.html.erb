<% content_for :title, @item.name %>

<div class="mx-auto md:w-2/3 w-full">
  <%= link_to "← กลับไปรายการพัสดุ", items_path, class: "text-sm text-gray-600 hover:underline" %>

  <div class="mt-4 bg-white rounded-lg shadow-sm p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="font-mono text-sm text-gray-500"><%= @item.sku %></p>
        <h1 class="text-2xl font-bold"><%= @item.name %></h1>
      </div>
      <% unless @item.active? %>
        <span class="rounded-full px-2 py-0.5 bg-gray-200 text-gray-600 text-sm">ปิดใช้งาน</span>
      <% end %>
    </div>

    <% if @item.description.present? %>
      <p class="mt-4 text-gray-700 whitespace-pre-line"><%= @item.description %></p>
    <% end %>

    <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-gray-500">จำนวนคงเหลือ</dt>
        <dd class="text-lg font-semibold" id="quantity">
          <%= number_with_delimiter(@item.quantity) %> <%= @item.unit %>
          <%= render "items/low_stock_badge", item: @item %>
        </dd>
      </div>
      <div>
        <dt class="text-gray-500">จุดแจ้งเตือนสต็อกต่ำ</dt>
        <dd class="text-lg font-semibold"><%= number_with_delimiter(@item.low_stock_threshold) %> <%= @item.unit %></dd>
      </div>
    </dl>

    <% if Current.user.admin? %>
      <div class="mt-6 flex flex-wrap gap-2" id="admin_actions">
        <%= link_to "ปรับสต็อก", new_admin_item_stock_adjustment_path(@item), class: "rounded-md px-3 py-1.5 bg-blue-50 text-blue-700 hover:bg-blue-100" %>
        <%= link_to "แก้ไข", edit_admin_item_path(@item), class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200" %>
      </div>
    <% end %>
  </div>
</div>
