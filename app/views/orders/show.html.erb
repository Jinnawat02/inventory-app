<% content_for :title, "ใบเบิก ##{@order.id}" %>

<div class="mx-auto md:w-2/3 w-full">
  <%= link_to "← ใบเบิกของฉัน", orders_path, class: "text-sm text-gray-600 hover:underline" %>

  <div class="mt-4 bg-white rounded-lg shadow-sm p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h1 class="text-2xl font-bold">ใบเบิก #<%= @order.id %></h1>
      <span id="order_status"><%= order_status_badge(@order) %></span>
    </div>

    <p class="mt-4 text-gray-700 whitespace-pre-line" id="order_purpose"><%= @order.purpose %></p>

    <%= render "orders/timeline", order: @order %>

    <%= render "orders/lines", order: @order %>

    <% if @order.rejected? %>
      <div class="mt-6 py-2 px-3 bg-red-50 text-red-700 rounded-lg" id="admin_note">
        <p class="font-medium">เหตุผลที่ไม่อนุมัติ</p>
        <p class="whitespace-pre-line"><%= @order.admin_note %></p>
      </div>
    <% end %>

    <% if @order.editable? %>
      <div class="mt-6 flex flex-wrap gap-2" id="owner_actions">
        <%= link_to "แก้ไข", edit_order_path(@order), class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200" %>
        <%= button_to "ยกเลิกใบเบิก", order_cancellation_path(@order), class: "rounded-md px-3 py-1.5 bg-red-50 text-red-700 hover:bg-red-100 cursor-pointer", data: { turbo_confirm: "ยืนยันการยกเลิกใบเบิก ##{@order.id}?" } %>
      </div>
    <% end %>
  </div>
</div>
