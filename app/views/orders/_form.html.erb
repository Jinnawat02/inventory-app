<%= form_with model: order, class: "space-y-5 bg-white rounded-lg shadow-sm p-6", data: { controller: "nested-form" } do |form| %>
  <%= render "shared/form_errors", record: order %>

  <div>
    <%= form.label :purpose, class: "block font-medium" %>
    <%= form.text_area :purpose, rows: 3, required: true, placeholder: "เช่น ใช้สำหรับงานประชุมประจำเดือน", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-1 w-full" %>
  </div>

  <fieldset>
    <legend class="font-medium mb-2">รายการเบิก</legend>

    <div class="space-y-3" data-nested-form-target="container" id="order_lines">
      <%= form.fields_for :order_items do |line| %>
        <%= render "orders/line_fields", line: line, items: items %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :order_items, OrderItem.new, child_index: "NEW_RECORD" do |line| %>
        <%= render "orders/line_fields", line: line, items: items %>
      <% end %>
    </template>

    <button type="button" class="mt-3 rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-sm cursor-pointer" data-action="nested-form#add">
      + เพิ่มรายการ
    </button>
  </fieldset>

  <div class="flex items-center gap-3">
    <%= form.submit order.persisted? ? "บันทึก" : "ส่งใบเบิก", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "ยกเลิก", order.persisted? ? order_path(order) : root_path, class: "text-gray-600 underline" %>
  </div>
<% end %>
