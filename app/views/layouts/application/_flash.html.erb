<% if alert = flash[:alert] %>
  <div class="py-2 px-3 bg-red-50 mb-5 text-red-600 font-medium rounded-lg" id="alert"><%= alert %></div>
<% end %>

<% if notice = flash[:notice] %>
  <div class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-lg" id="notice"><%= notice %></div>
<% end %>
